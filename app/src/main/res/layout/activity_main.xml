<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenshot_canvas">

    <!-- Top Minimalist Header (1:1 with Screenshot) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@color/screenshot_canvas">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@color/screenshot_text_title"
            android:contentDescription="OmniCrawler Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="OmniCrawler"
            android:textColor="@color/screenshot_text_title"
            android:textStyle="bold"
            android:textSize="15.5sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Model Selector Capsule -->
        <Spinner
            android:id="@+id/spinnerModel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_screenshot_input"
            android:paddingHorizontal="10dp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/screenshot_text_title"
            android:contentDescription="服务配置" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="@color/screenshot_text_title"
            android:contentDescription="历史记录" />

    </LinearLayout>

    <!-- Linear Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/screenshot_blue_primary"
        android:visibility="gone" />

    <!-- Scrollable Main Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="36dp">

            <!-- Hero Header Card (1:1 Match) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_screenshot_icon_box">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@color/screenshot_text_title" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="多源信息采集与 AI 深度研判"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/screenshot_text_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="支持公众号、知乎、GitHub、X 长文、小红书与多篇链接交叉对比。"
                        android:textSize="11.5sp"
                        android:textColor="@color/screenshot_text_sub"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Mode Switcher Capsule (单篇精读 vs 多源交叉对比) -->
            <LinearLayout
                android:id="@+id/modeTrack"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_screenshot_track"
                android:padding="3dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tabModeSingle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="📄 单篇精读"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/screenshot_text_title"
                    android:background="@drawable/bg_screenshot_pill_active" />

                <TextView
                    android:id="@+id/tabModeCompare"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🔀 多源交叉对比"
                    android:textSize="12.5sp"
                    android:textColor="@color/screenshot_text_sub" />

            </LinearLayout>

            <!-- Input Box Card (1:1 White Card with 1px border) -->
            <LinearLayout
                android:id="@+id/cardInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_screenshot_card"
                android:padding="14dp"
                android:layout_marginTop="12dp">

                <!-- Link Input Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_screenshot_input"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_share"
                        app:tint="@color/screenshot_text_sub" />

                    <EditText
                        android:id="@+id/editUrl"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="粘贴文章链接 (微信公众号 / 知乎 / GitHub / X 等)"
                        android:textSize="12.5sp"
                        android:textColor="@color/screenshot_text_title"
                        android:textColorHint="@color/screenshot_text_muted"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:scrollHorizontally="true" />

                    <ImageButton
                        android:id="@+id/btnClearUrl"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/screenshot_text_muted"
                        android:visibility="gone"
                        android:contentDescription="清空" />

                </LinearLayout>

                <!-- Dual Action Buttons (仅提取 & 提取并深度分析) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExtractOnly"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="📄 仅提取"
                        android:textSize="12.5sp"
                        android:textColor="@color/screenshot_text_title"
                        app:strokeColor="@color/screenshot_border"
                        app:backgroundTint="@color/screenshot_card_bg"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExtractAndAnalyze"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.3"
                        android:text="✨ 提取并深度分析"
                        android:textSize="12.5sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="@color/screenshot_blue_primary"
                        app:cornerRadius="8dp" />

                </LinearLayout>

                <!-- 支持平台 Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支持平台"
                    android:textSize="11.5sp"
                    android:textColor="@color/screenshot_text_sub"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <!-- Platform Badges Cloud (1:1 Match from Screenshot) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/badgeGithub"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_github"
                            android:paddingHorizontal="10dp"
                            android:text="🐙 GitHub"
                            android:textSize="11.5sp"
                            android:textColor="@color/badge_github_text" />

                        <TextView
                            android:id="@+id/badgeWechat"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_wechat"
                            android:paddingHorizontal="10dp"
                            android:text="💬 微信公众号"
                            android:textSize="11.5sp"
                            android:textColor="@color/badge_wechat_text" />

                        <TextView
                            android:id="@+id/badgeZhihu"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_zhihu"
                            android:paddingHorizontal="10dp"
                            android:text="知 知乎专栏"
                            android:textSize="11.5sp"
                            android:textColor="@color/badge_zhihu_text" />

                    </LinearLayout>

                    <!-- Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/badgeX"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_x"
                            android:paddingHorizontal="10dp"
                            android:text="𝕏 X (Twitter)"
                            android:textSize="11.5sp"
                            android:textColor="@color/badge_x_text" />

                        <TextView
                            android:id="@+id/badgeXhs"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_xhs"
                            android:paddingHorizontal="10dp"
                            android:text="📕 小红书"
                            android:textSize="11.5sp"
                            android:textColor="@color/badge_xhs_text" />

                        <TextView
                            android:id="@+id/badgeBili"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_bili"
                            android:paddingHorizontal="10dp"
                            android:text="📺 Bilibili"
                            android:textSize="11.5sp"
                            android:textColor="@color/badge_bili_text" />

                    </LinearLayout>

                    <!-- Row 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/badgeSearch"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_search"
                            android:paddingHorizontal="10dp"
                            android:text="🔍 全网主题检索"
                            android:textSize="11.5sp"
                            android:textColor="@color/badge_search_text" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Result Section Container -->
            <LinearLayout
                android:id="@+id/layoutResultSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <!-- Segmented Result View Switcher (提取正文 vs AI深度研报) -->
                <LinearLayout
                    android:id="@+id/resultViewTrack"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_screenshot_track"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/tabViewRaw"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="📄 提取正文"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/screenshot_text_title"
                        android:background="@drawable/bg_screenshot_pill_active" />

                    <TextView
                        android:id="@+id/tabViewReport"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="✨ AI 深度研报  ●"
                        android:textSize="12.5sp"
                        android:textColor="@color/screenshot_blue_primary" />

                </LinearLayout>

                <!-- AI Analysis Dimension Pills (Shown in AI Report mode) -->
                <HorizontalScrollView
                    android:id="@+id/scrollDimensions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/dimensionTrack"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_screenshot_track"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/dimSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="深度精读"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/screenshot_text_title"
                            android:background="@drawable/bg_screenshot_pill_active" />

                        <TextView
                            android:id="@+id/dimAction"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="行动清单"
                            android:textSize="11sp"
                            android:textColor="@color/screenshot_text_sub" />

                        <TextView
                            android:id="@+id/dimCritique"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="批判洞察"
                            android:textSize="11sp"
                            android:textColor="@color/screenshot_text_sub" />

                        <TextView
                            android:id="@+id/dimRoast"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="毒舌锐评"
                            android:textSize="11sp"
                            android:textColor="@color/screenshot_text_sub" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Result Header & Metadata Card (1:1 2-Tier Header) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_screenshot_card"
                    android:padding="14dp"
                    android:layout_marginTop="12dp">

                    <!-- Tier 1: Title & Copy Icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="@color/screenshot_text_title" />

                        <TextView
                            android:id="@+id/tvHeaderTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Skill 持续升级指南：让 AI 从记住方法走向自动驾驶"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/screenshot_text_title"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageButton
                            android:id="@+id/btnCopyHeader"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_save"
                            app:tint="@color/screenshot_text_sub"
                            android:contentDescription="复制" />

                    </LinearLayout>

                    <!-- Tier 2: Metadata Pills & Refresh Icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvPlatformBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_x"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="𝕏 X (Twitter)"
                            android:textSize="10.5sp"
                            android:textColor="@color/badge_x_text" />

                        <TextView
                            android:id="@+id/tvWordsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="7791 字"
                            android:textSize="11.5sp"
                            android:textColor="@color/screenshot_text_sub" />

                        <TextView
                            android:id="@+id/tvCacheBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_cache"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="⚡ 缓存命中 (0ms)"
                            android:textSize="10sp"
                            android:textColor="@color/badge_cache_text" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btnReExtract"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_popup_sync"
                            app:tint="@color/screenshot_text_sub"
                            android:contentDescription="重新抓取" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/screenshot_border"
                        android:layout_marginVertical="12dp" />

                    <!-- Article Large Bold H1 -->
                    <TextView
                        android:id="@+id/tvBodyHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Skill 持续升级指南：\n让 AI 从记住方法走向自动驾驶"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/screenshot_text_title"
                        android:lineSpacingExtra="3dp" />

                    <!-- Meta Quote Block (1:1 with Screenshot) -->
                    <LinearLayout
                        android:id="@+id/layoutMetaQuote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_meta_quote_box"
                        android:padding="10dp"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tvMetaAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="作者: 苏乐 (@ai_suxiaole)   互动数据: 点赞: 110 | 转发: 15 | 回复: 11 | 阅读量: 20707"
                            android:textSize="11sp"
                            android:textColor="@color/screenshot_text_body"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:id="@+id/tvMetaPublishTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="发布时间: 2026-08-30T10:27:31.000Z"
                            android:textSize="11sp"
                            android:textColor="@color/screenshot_text_body" />

                    </LinearLayout>

                    <!-- Article / Report Content Canvas -->
                    <TextView
                        android:id="@+id/tvMainContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textIsSelectable="true"
                        android:textColor="@color/screenshot_text_body"
                        android:textSize="14sp"
                        android:lineSpacingExtra="6.5dp"
                        android:letterSpacing="-0.01" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Dock (1:1 Match) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_notion_bottom_dock"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPushFeishu"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.1"
            android:layout_marginEnd="6dp"
            android:text="推送到飞书私聊"
            android:textSize="11sp"
            android:textColor="@color/notion_blue_text"
            app:backgroundTint="@color/notion_blue_light"
            app:cornerRadius="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyReport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:text="复制"
            android:textSize="11sp"
            android:textColor="@color/screenshot_text_title"
            app:strokeColor="@color/screenshot_border_dark"
            app:cornerRadius="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenChat"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="深度追问"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/screenshot_text_title"
            app:cornerRadius="6dp" />

    </LinearLayout>

</LinearLayout>
