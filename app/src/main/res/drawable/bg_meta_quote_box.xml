<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/screenshot_canvas" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:gravity="left">
        <shape>
            <size android:width="3.5dp" />
            <solid android:color="@color/screenshot_text_title" />
            <corners android:topLeftRadius="6dp" android:bottomLeftRadius="6dp" />
        </shape>
    </item>
</layer-list>
